# ─────────────────────────────────────────────────────────────────────────────
# AI Image Editor — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compute mode ──────────────────────────────────────────────────────────────
# local  → download models to ./weights/ and run everything on your GPU/CPU (default)
# remote → skip local models entirely; route all AI calls to cloud APIs
COMPUTE_MODE=local

# ── Path environment (existing setting) ───────────────────────────────────────
# local  → use ./temp, ./outputs, ./projects, ./weights  (default for local dev)
# server → use Google Drive paths (for Colab / cloud VM)
ENV=local

# ─────────────────────────────────────────────────────────────────────────────
# Remote API Keys  (only needed when COMPUTE_MODE=remote)
# ─────────────────────────────────────────────────────────────────────────────

# fal.ai — segmentation (SAM2), inpainting (FLUX / SDXL),
#           background removal (rembg / Bria), upscaling (ESRGAN)
#   Get your key at: https://fal.ai/dashboard/keys
FAL_API_KEY=

# Replicate — alternative for Grounding DINO detection, SAM2, SDXL, ESRGAN
#   Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Groq — LLM prompt parsing (Llama 3.1-8B, extremely fast + cheap)
#   Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — fallback LLM (GPT-4o-mini) + vision object identification
#   Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — alternative LLM (Claude Haiku) if preferred over OpenAI
#   Get your key at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# remove.bg — dedicated background removal API (best for hair/complex edges)
#   Get your key at: https://www.remove.bg/api
REMOVEBG_API_KEY=

# Stability AI — alternative inpainting / upscale / background removal
#   Get your key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Provider Preferences  (only matter when COMPUTE_MODE=remote)
# Change these to swap providers without touching any code.
# ─────────────────────────────────────────────────────────────────────────────

# Object detection: "replicate" | "fal"
DETECTION_PROVIDER=replicate

# Segmentation (SAM2 masking): "fal" | "replicate"
SEGMENTATION_PROVIDER=fal

# Inpainting (replace / anime / oil_painting / generative_fill):
#   "fal" | "replicate" | "stability"
INPAINT_PROVIDER=fal

# LLM for prompt → JSON parsing: "groq" | "openai" | "anthropic"
LLM_PROVIDER=groq

# Background removal: "fal" | "removebg" | "stability"
REMBG_PROVIDER=fal

# Upscaling: "fal" | "replicate"
UPSCALE_PROVIDER=fal

# Vision model for object identification (optional step):
#   "openai" | "anthropic"
VISION_PROVIDER=openai

# ─────────────────────────────────────────────────────────────────────────────
# Optional model overrides  (only matter when COMPUTE_MODE=remote)
# ─────────────────────────────────────────────────────────────────────────────

# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-3-5
# OPENAI_VISION_MODEL=gpt-4o-mini
# ANTHROPIC_VISION_MODEL=claude-haiku-3-5

# ─────────────────────────────────────────────────────────────────────────────
# Remote timeout settings  (only matter when COMPUTE_MODE=remote)
# ─────────────────────────────────────────────────────────────────────────────

# Seconds to wait for a synchronous HTTP response
# REMOTE_HTTP_TIMEOUT=120

# Seconds between poll attempts for async queue-based APIs (fal.ai, Replicate)
# REMOTE_POLL_INTERVAL=2.0

# Max total seconds to wait for an async job before giving up
# REMOTE_ASYNC_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# Idle model unload  (only matters when COMPUTE_MODE=local)
# ─────────────────────────────────────────────────────────────────────────────

# Unload local models after this many seconds of inactivity (default: 120)
# MODEL_IDLE_SECONDS=120
