#!/bin/bash

git status
git add .

# Use the provided branch, otherwise use the current branch
BRANCH="${1:-$(git branch --show-current)}"

if [ -n "$2" ]; then
    git commit -m "updated - $2 - $(date '+%d/%m/%Y %H:%M:%S')"
else
    git commit -m "updated - $(date '+%d/%m/%Y %H:%M:%S')"
fi

git push origin "$BRANCH"

echo "Pushed to $BRANCH!"
